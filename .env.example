# Postgres DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# SUPABASE
SUPABASE_URL=
SUPABASE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=

# Rate limiting (defaults: 60000ms window, 10 requests)
THROTTLE_TTL=
THROTTLE_LIMIT=

# CORS allowed origins — comma-separated, no spaces required.
#   empty -> reflect request origin (dev)   "*" -> allow any origin
#   e.g.  http://localhost:5173,https://app.example.com
CORS_ORIGINS=